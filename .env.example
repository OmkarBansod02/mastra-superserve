# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for anything that starts a VM (examples, smoke tests).
SUPERSERVE_API_KEY=
# Optional: override the Superserve API endpoint.
# SUPERSERVE_BASE_URL=

# Required only for the OpenAI agent examples (example:agent, example:launch).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# --- pnpm example:agent (docs/DEMO.md) ---
# MAX_STEPS=10
# DEBUG_IMAGES=0
# Live [AGENT] logs plus a scripted pause/reconnect after the agent finishes.
# DEMO_MODE=0
# With DEMO_MODE: a second, independent agent session on the reconnected VM.
# DEMO_CONTINUE=0
# DEMO_CONTINUE_MAX_STEPS=15
# Only install and verify Mousepad on one VM; no agent, no OpenAI calls.
# DEMO_SETUP_ONLY=0

# --- pnpm example:launch (docs/LAUNCH-DEMO.md) ---
# LAUNCH_S1_MAX_STEPS=38
# LAUNCH_S2_MAX_STEPS=30
# LAUNCH_EDITOR_LOOK=1

# --- Shared by both examples ---
# Install Mousepad (apt-get via passwordless sudo) if the VM has no GUI text editor.
# DEMO_SETUP_EDITOR=0
# Serve http://localhost:7777/ as a redirect to a private, view-only desktop viewer.
# DEMO_VIEWER=0
# DEMO_VIEWER_PORT=7777
