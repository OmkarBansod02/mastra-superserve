# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for anything that starts a VM (examples, smoke tests).
SUPERSERVE_API_KEY=
# Optional: override the Superserve API endpoint.
# SUPERSERVE_BASE_URL=

# Required only for the OpenAI computer-use agent (pnpm example:agent).
OPENAI_API_KEY=
# Optional agent settings (defaults shown).
# OPENAI_MODEL=gpt-5.4-mini
# MAX_STEPS=10
# DEBUG_IMAGES=0
