# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for anything that starts a VM (examples, smoke tests).
SUPERSERVE_API_KEY=
# Optional: override the Superserve API endpoint.
# SUPERSERVE_BASE_URL=

# Required only for the OpenAI computer-use agent (pnpm example:agent).
OPENAI_API_KEY=
# Optional agent settings (defaults shown).
# OPENAI_MODEL=gpt-5.4-mini
# MAX_STEPS=10
# DEBUG_IMAGES=0
# Recording mode (docs/DEMO.md): live [AGENT] logs + scripted pause/reattach showcase.
# DEMO_MODE=0
# With DEMO_MODE: serve a localhost redirect to a private, view-only desktop viewer.
# DEMO_VIEWER=0
# DEMO_VIEWER_PORT=7777
# If the VM has no GUI text editor, install Mousepad (apt-get via sudo) before the agent runs.
# DEMO_SETUP_EDITOR=0
# DEMO_SETUP_ONLY=0
