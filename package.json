{
  "name": "mastra-superserve",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial Superserve desktop (computer-use) sandbox provider for Mastra workspaces",
  "keywords": [
    "mastra",
    "superserve",
    "sandbox",
    "computer-use",
    "agents",
    "workspace"
  ],
  "license": "Apache-2.0",
  "author": "Omkar Bansod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmkarBansod02/mastra-superserve.git"
  },
  "bugs": {
    "url": "https://github.com/OmkarBansod02/mastra-superserve/issues"
  },
  "homepage": "https://github.com/OmkarBansod02/mastra-superserve#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.env smoke/desktop-smoke.ts",
    "e2e": "tsx --env-file-if-exists=.env examples/workspace-e2e.ts",
    "example:agent": "tsx --env-file-if-exists=.env examples/agent.ts",
    "example:launch": "tsx --env-file-if-exists=.env examples/launch-demo.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@superserve/sdk": "0.11.4"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0"
  },
  "devDependencies": {
    "@mastra/core": "1.80.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
